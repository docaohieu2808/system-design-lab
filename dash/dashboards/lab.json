{
 "uid": "lab",
 "title": "System Design Lab",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "2s",
 "time": {
  "from": "now-5m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests per second (k6)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(k6_http_reqs_total[6s]))",
     "legendFormat": "sent/answered",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Latency p99 (k6)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(k6_http_req_duration_p99)",
     "legendFormat": "p99",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "max(k6_http_req_duration_p50)",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Failed requests (k6)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100*max(k6_http_req_failed_rate)",
     "legendFormat": "failed %",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Dropped iterations (k6): requests k6 could not send",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(k6_dropped_iterations_total[6s])) or vector(0)",
     "legendFormat": "dropped/s",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "CPU of each lab container (cores)",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"sdlab-.*\"}[6s]))",
     "legendFormat": "{{name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Memory of each lab container",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"sdlab-.*\"})",
     "legendFormat": "{{name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  }
 ]
}