#!/bin/sh
# Maintainer hook (git config core.hooksPath tools/git-hooks): refuse to commit files that name services or hosts
# outside the lab, since the repo is public and results are recorded on a machine that runs other things.
# The lab's own dashboard pulls the public image gcr.io/cadvisor/cadvisor; that exact reference is allowed, any other
# "cadvisor" (for example the machine's own container in a CPU sample) is still refused.
files=$(git diff --cached --name-only -- . ":(exclude)tools/git-hooks")
[ -z "$files" ] && exit 0
bad=""
for f in $files; do
  git cat-file -e ":$f" 2>/dev/null || continue
  git show ":$f" | grep -qI . || continue
  if git show ":$f" | sed 's#gcr\.io/cadvisor/cadvisor##g' | grep -qE "finance|file-drop|devops-lab|beszel|dozzle|form-gym|pg-shared|cadvisor|socket-proxy|docaohieu\.com|@docaohieu|hieudc|tailscale|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]+\.[0-9]+"; then
    bad="$bad
$f"
  fi
done
[ -z "$bad" ] && exit 0
echo "pre-commit: these files name private services or hosts, clean them first:$bad"; exit 1
